# Copy to terraform.tfvars and fill in real values. Every value below is
# a placeholder; never commit a real terraform.tfvars (see .gitignore /
# ADR-0015).

aws_account_id           = "000000000000"
create_github_oidc_provider = false
github_oidc_subject_prefix = null # Set the verified sub_claim_prefix in ignored tfvars when immutable subjects are enabled.
github_oidc_provider_arn = null
github_repo              = "REPLACE_ME/archibrief"

lambda_zip_paths = {
  ingest                     = "../../../backend/lambdas/ingest/build/ingest.zip"
  rule_engine                = "../../../backend/lambdas/rule_engine/build/rule_engine.zip"
  validate                   = "../../../backend/lambdas/validate/build/validate.zip"
  audit                      = "../../../backend/lambdas/audit/build/audit.zip"
  finalize                   = "../../../backend/lambdas/finalize/build/finalize.zip"
  store_clarification_token  = "../../../backend/lambdas/store_clarification_token/build/store_clarification_token.zip"
}

# GET /reviews/{reviewId}, POST .../clarify, POST .../deeper and
# GET /demo Lambdas.
get_review_zip_path     = "../../../backend/lambdas/get_review/build/get_review.zip"
clarify_review_zip_path = "../../../backend/lambdas/clarify_review/build/clarify_review.zip"
deeper_review_zip_path  = "../../../backend/lambdas/deeper_review/build/deeper_review.zip"
get_demo_zip_path       = "../../../backend/lambdas/get_demo/build/get_demo.zip"

# POST /uploads Lambda, the direct-upload design (ADR-0045).
create_upload_zip_path  = "../../../backend/lambdas/create_upload/build/create_upload.zip"

# AgentCore Runtime entrypoint package (backend/agent/runtime_entrypoint.py),
# built for Linux ARM64 by backend/agent/build_runtime_package.py.
agentcore_runtime_zip_path = "../../../backend/agent/build/agentcore-runtime.zip"

# AWS Budgets threshold notifications (ADR-0040). Use a real inbox; SNS
# emails it and the subscription must be confirmed.
alert_email        = "REPLACE_ME@example.com"
monthly_budget_usd = 20
