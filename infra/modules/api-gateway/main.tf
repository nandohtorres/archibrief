# Terraform module: api-gateway
# HTTP API (API Gateway v2) gated by a single pre-shared admin credential
# (ADR-0044; there are no user accounts and no Cognito JWT authorizer).
# Throttling is a best-effort layer, not a guaranteed ceiling (ADR-0005,
# ADR-0030); real enforcement is the application-level controls in the
# backend. POST /reviews integrates directly with Step Functions
# StartExecution, with no BFF Lambda (ADR-0016/0042). GET /demo serves a
# precomputed report and is intentionally public. The other routes are
# Lambda proxy integrations.

resource "aws_apigatewayv2_api" "main" {
  name          = "${var.name_prefix}-api"
  protocol_type = "HTTP"

  cors_configuration {
    # Both the raw CloudFront origin and the custom domain(s) must be
    # allowed, or every browser request from the missing origin fails CORS.
    allow_origins = concat([var.frontend_origin], var.additional_cors_origins)
    allow_methods = ["GET", "POST", "OPTIONS"]
    allow_headers = ["authorization", "content-type", "x-admin-key", "x-review-read-token", "x-review-write-token"]
  }

  tags = var.tags
}

# Single pre-shared admin credential, generated by Terraform and stored
# in Secrets Manager (ADR-0044), never committed to source. The operator
# retrieves it once (AWS console/CLI, or the sensitive `terraform output`)
# and pastes it into the frontend's admin-key field; it is sent as the
# `x-admin-key` header on every gated request.
resource "random_password" "admin_key" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "admin_key" {
  name = "${var.name_prefix}-admin-key"
  tags = var.tags

  # Dev-only, no audit-retention need. Without this, destroy/replace leaves
  # a same-named secret stuck in AWS's default 30-day recovery window and
  # the next create fails.
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "admin_key" {
  secret_id     = aws_secretsmanager_secret.admin_key.id
  secret_string = random_password.admin_key.result
}

data "aws_iam_policy_document" "admin_authorizer_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "admin_authorizer" {
  name                 = "${var.name_prefix}-admin-authorizer"
  assume_role_policy   = data.aws_iam_policy_document.admin_authorizer_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy_attachment" "admin_authorizer_basic_logs" {
  role       = aws_iam_role.admin_authorizer.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_lambda_function" "admin_authorizer" {
  function_name    = "${var.name_prefix}-admin-authorizer"
  role             = aws_iam_role.admin_authorizer.arn
  handler          = "backend.lambdas.admin_authorizer.handler.handler"
  runtime          = "python3.12"
  filename         = var.admin_authorizer_zip_path
  source_code_hash = fileexists(var.admin_authorizer_zip_path) ? filebase64sha256(var.admin_authorizer_zip_path) : null
  timeout          = 3

  environment {
    variables = {
      ADMIN_KEY = random_password.admin_key.result
      PUBLIC_ACCESS_ENABLED = local.public_admitted ? "true" : "false"
      PUBLIC_REST_API_ID = var.public_edge_enabled ? aws_api_gateway_rest_api.public[0].id : ""
    }
  }

  tags = var.tags
}

resource "aws_lambda_permission" "apigw_invoke_admin_authorizer" {
  statement_id  = "AllowAPIGatewayInvokeAdminAuthorizer"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.admin_authorizer.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.main.execution_arn}/*/*"
}

resource "aws_apigatewayv2_authorizer" "admin_gate" {
  api_id                            = aws_apigatewayv2_api.main.id
  authorizer_type                   = "REQUEST"
  name                              = "${var.name_prefix}-admin-gate"
  authorizer_uri                    = aws_lambda_function.admin_authorizer.invoke_arn
  authorizer_payload_format_version = "2.0"
  enable_simple_responses           = true
  authorizer_result_ttl_in_seconds  = 0
  identity_sources                  = ["$request.header.x-admin-key"]
}

data "aws_iam_policy_document" "apigw_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["apigateway.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "apigw_invoke_step_functions" {
  name                 = "${var.name_prefix}-apigw-invoke-sfn"
  assume_role_policy   = data.aws_iam_policy_document.apigw_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy" "apigw_invoke_step_functions" {
  name = "${var.name_prefix}-apigw-start-execution"
  role = aws_iam_role.apigw_invoke_step_functions.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "states:StartExecution"
      Resource = var.state_machine_arn
    }]
  })
}

resource "aws_apigatewayv2_integration" "start_review" {
  api_id                 = aws_apigatewayv2_api.main.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.submit_review.invoke_arn
  payload_format_version = "2.0"
}

# POST /reviews is the only route on the StartExecution integration.
# Never point another route at it as a stand-in: any caller could then
# trigger a billed Step Functions execution.
#
# authorizer_id points at the pre-shared admin-credential authorizer
# (ADR-0044), the only auth ArchiBrief has; there is no per-user identity.
resource "aws_apigatewayv2_route" "post_reviews" {
  api_id             = aws_apigatewayv2_api.main.id
  route_key          = "POST /reviews"
  target             = "integrations/${aws_apigatewayv2_integration.start_review.id}"
  authorizer_id      = aws_apigatewayv2_authorizer.admin_gate.id
  authorization_type = "CUSTOM"
}

# GET /reviews/{reviewId} and POST /reviews/{reviewId}/clarify need a
# DynamoDB read and a task-token resume (states:SendTaskSuccess). API
# Gateway v2's AWS_PROXY integration subtypes support neither, so both
# are Lambda proxy integrations with payload format 2.0 (see
# backend/lambdas/get_review/handler.py's module docstring).
data "aws_iam_policy_document" "review_reader_data_access" {
  statement {
    effect    = "Allow"
    actions   = ["dynamodb:GetItem"]
    resources = [var.reviews_table_arn]
  }
  # get_review reads the S3 evidence ledger to assemble the ReviewReport
  # (backend.shared.report) once a review is complete.
  statement {
    effect    = "Allow"
    actions   = ["s3:GetObject"]
    resources = ["${var.reports_bucket_arn}/*"]
  }
}

resource "aws_iam_role" "get_review" {
  name                 = "${var.name_prefix}-get-review"
  assume_role_policy   = data.aws_iam_policy_document.admin_authorizer_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy_attachment" "get_review_basic_logs" {
  role       = aws_iam_role.get_review.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "get_review_data_access" {
  name   = "${var.name_prefix}-get-review-data-access"
  role   = aws_iam_role.get_review.id
  policy = data.aws_iam_policy_document.review_reader_data_access.json
}

resource "aws_lambda_function" "get_review" {
  function_name    = "${var.name_prefix}-get-review"
  role             = aws_iam_role.get_review.arn
  handler          = "backend.lambdas.get_review.handler.handler"
  runtime          = "python3.12"
  filename         = var.get_review_zip_path
  source_code_hash = fileexists(var.get_review_zip_path) ? filebase64sha256(var.get_review_zip_path) : null
  timeout          = 3

  environment {
    variables = merge(local.admission_environment, {
      REVIEWS_TABLE_NAME  = var.reviews_table_name
      REPORTS_BUCKET_NAME = var.reports_bucket_name
    })
  }

  tags = var.tags
}

resource "aws_lambda_permission" "apigw_invoke_get_review" {
  statement_id  = "AllowAPIGatewayInvokeGetReview"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.get_review.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.main.execution_arn}/*/*"
}

resource "aws_apigatewayv2_integration" "get_review" {
  api_id                 = aws_apigatewayv2_api.main.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.get_review.invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "get_review" {
  api_id             = aws_apigatewayv2_api.main.id
  route_key          = "GET /reviews/{reviewId}"
  target             = "integrations/${aws_apigatewayv2_integration.get_review.id}"
  authorizer_id      = aws_apigatewayv2_authorizer.admin_gate.id
  authorization_type = "CUSTOM"
}

# clarify_review needs GetItem+UpdateItem (reads the pending token, then
# claims it with a conditional field-level update before resuming) plus
# states:SendTaskSuccess, which must be scoped to resource "*": the
# task-token API has no ARN-scoped resource, and the token itself is the
# authorization.
data "aws_iam_policy_document" "clarify_review_data_access" {
  statement {
    # ADR-0030 kill switch, checked before any paid work.
    effect    = "Allow"
    actions   = ["ssm:GetParameter"]
    resources = [var.kill_switch_parameter_arn]
  }
  statement {
    effect    = "Allow"
    actions   = ["dynamodb:GetItem", "dynamodb:UpdateItem"]
    resources = [var.reviews_table_arn]
  }
  statement {
    effect    = "Allow"
    actions   = ["states:SendTaskSuccess", "states:SendTaskFailure"]
    resources = ["*"]
  }
}

resource "aws_iam_role" "clarify_review" {
  name                 = "${var.name_prefix}-clarify-review"
  assume_role_policy   = data.aws_iam_policy_document.admin_authorizer_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy_attachment" "clarify_review_basic_logs" {
  role       = aws_iam_role.clarify_review.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "clarify_review_data_access" {
  name   = "${var.name_prefix}-clarify-review-data-access"
  role   = aws_iam_role.clarify_review.id
  policy = data.aws_iam_policy_document.clarify_review_data_access.json
}

resource "aws_lambda_function" "clarify_review" {
  function_name    = "${var.name_prefix}-clarify-review"
  role             = aws_iam_role.clarify_review.arn
  handler          = "backend.lambdas.clarify_review.handler.handler"
  runtime          = "python3.12"
  filename         = var.clarify_review_zip_path
  source_code_hash = fileexists(var.clarify_review_zip_path) ? filebase64sha256(var.clarify_review_zip_path) : null
  timeout          = 10

  environment {
    variables = merge(local.admission_environment, {
      REVIEWS_TABLE_NAME         = var.reviews_table_name
      KILL_SWITCH_PARAMETER_NAME = var.kill_switch_parameter_name
    })
  }

  tags = var.tags
}

resource "aws_lambda_permission" "apigw_invoke_clarify_review" {
  statement_id  = "AllowAPIGatewayInvokeClarifyReview"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.clarify_review.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.main.execution_arn}/*/*"
}

resource "aws_apigatewayv2_integration" "clarify_review" {
  api_id                 = aws_apigatewayv2_api.main.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.clarify_review.invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "post_clarify" {
  api_id = aws_apigatewayv2_api.main.id
  # reviewId is in the path, matching the frontend's lib/api.ts.
  route_key          = "POST /reviews/{reviewId}/clarify"
  target             = "integrations/${aws_apigatewayv2_integration.clarify_review.id}"
  authorizer_id      = aws_apigatewayv2_authorizer.admin_gate.id
  authorization_type = "CUSTOM"
}

# POST /reviews/{reviewId}/findings/{findingId}/deeper: a scoped
# per-finding re-run, never the full pipeline (ADR-0023/ADR-0039). Not a
# Step Functions integration: deeper_review.handler calls the AgentCore
# Runtime directly through boto3 (AgentCoreRuntimeClient).
data "aws_iam_policy_document" "deeper_review_data_access" {
  statement {
    # ADR-0030 kill switch, checked before any paid work.
    effect    = "Allow"
    actions   = ["ssm:GetParameter"]
    resources = [var.kill_switch_parameter_arn]
  }
  statement {
    # UpdateItem: the per-finding in-flight claim.
    effect    = "Allow"
    actions   = ["dynamodb:GetItem", "dynamodb:UpdateItem"]
    resources = [var.reviews_table_arn]
  }
  statement {
    # Query: return an already-stored deeper result instead of paying for
    # a second run.
    effect    = "Allow"
    actions   = ["dynamodb:PutItem", "dynamodb:Query"]
    resources = [var.findings_table_arn]
  }
  statement {
    effect    = "Allow"
    actions   = ["s3:GetObject"]
    resources = ["${var.reports_bucket_arn}/*"]
  }
  dynamic "statement" {
    for_each = var.agentcore_runtime_arn == null ? [] : [1]
    content {
      effect    = "Allow"
      actions   = ["bedrock-agentcore:InvokeAgentRuntime"]
      resources = [var.agentcore_runtime_arn]
    }
  }
}

resource "aws_iam_role" "deeper_review" {
  name                 = "${var.name_prefix}-deeper-review"
  assume_role_policy   = data.aws_iam_policy_document.admin_authorizer_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy_attachment" "deeper_review_basic_logs" {
  role       = aws_iam_role.deeper_review.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "deeper_review_data_access" {
  name   = "${var.name_prefix}-deeper-review-data-access"
  role   = aws_iam_role.deeper_review.id
  policy = data.aws_iam_policy_document.deeper_review_data_access.json
}

resource "aws_lambda_function" "deeper_review" {
  function_name    = "${var.name_prefix}-deeper-review"
  role             = aws_iam_role.deeper_review.arn
  handler          = "backend.lambdas.deeper_review.handler.handler"
  runtime          = "python3.12"
  filename         = var.deeper_review_zip_path
  source_code_hash = fileexists(var.deeper_review_zip_path) ? filebase64sha256(var.deeper_review_zip_path) : null
  # Longer than get_review/clarify_review (3s/10s): this path makes a
  # synchronous Bedrock-backed AgentCore call (retrieve + reason). Kept
  # under the HTTP API's 30s integration limit; otherwise the gateway
  # returns 503 while the Lambda keeps running and paying, and a client
  # retry starts a second run. The handler's AgentCore read timeout (24s)
  # sits under this.
  timeout = 28

  environment {
    variables = merge(local.admission_environment, {
      REVIEWS_TABLE_NAME         = var.reviews_table_name
      FINDINGS_TABLE_NAME        = var.findings_table_name
      KILL_SWITCH_PARAMETER_NAME = var.kill_switch_parameter_name
      REPORTS_BUCKET_NAME        = var.reports_bucket_name
      # Same placeholder ARN as modules/step-functions-lambda's InvokeAgent
      # task: the Lambda deploys without a runtime and fails only at
      # invocation time.
      AGENTCORE_RUNTIME_ARN = coalesce(var.agentcore_runtime_arn, "arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/not-yet-deployed")
    })
  }

  tags = var.tags
}

resource "aws_lambda_permission" "apigw_invoke_deeper_review" {
  statement_id  = "AllowAPIGatewayInvokeDeeperReview"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.deeper_review.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.main.execution_arn}/*/*"
}

resource "aws_apigatewayv2_integration" "deeper_review" {
  api_id                 = aws_apigatewayv2_api.main.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.deeper_review.invoke_arn
  payload_format_version = "2.0"
  # Explicit, and above the Lambda's 28s, so the Lambda's own timeout
  # response reaches the caller rather than a bare gateway 503.
  timeout_milliseconds = 29000
}

resource "aws_apigatewayv2_route" "post_deeper" {
  api_id             = aws_apigatewayv2_api.main.id
  route_key          = "POST /reviews/{reviewId}/findings/{findingId}/deeper"
  target             = "integrations/${aws_apigatewayv2_integration.deeper_review.id}"
  authorizer_id      = aws_apigatewayv2_authorizer.admin_gate.id
  authorization_type = "CUSTOM"
}

# GET /demo is the one deliberately public, unauthenticated route
# (ADR-0029, ADR-0044). It serves a precomputed reference report
# (backend/lambdas/get_demo) and never touches DynamoDB, S3, Step
# Functions, or AgentCore, so it has no pipeline cost, only normal
# static-content exposure.
resource "aws_iam_role" "get_demo" {
  name                 = "${var.name_prefix}-get-demo"
  assume_role_policy   = data.aws_iam_policy_document.admin_authorizer_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy_attachment" "get_demo_basic_logs" {
  role       = aws_iam_role.get_demo.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_lambda_function" "get_demo" {
  function_name    = "${var.name_prefix}-get-demo"
  role             = aws_iam_role.get_demo.arn
  handler          = "backend.lambdas.get_demo.handler.handler"
  runtime          = "python3.12"
  filename         = var.get_demo_zip_path
  source_code_hash = fileexists(var.get_demo_zip_path) ? filebase64sha256(var.get_demo_zip_path) : null
  timeout          = 3

  environment {
    variables = { CORS_ALLOWED_ORIGINS = jsonencode(concat([var.frontend_origin], var.additional_cors_origins)) }
  }
  tags = var.tags
}

resource "aws_lambda_permission" "apigw_invoke_get_demo" {
  statement_id  = "AllowAPIGatewayInvokeGetDemo"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.get_demo.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.main.execution_arn}/*/*"
}

resource "aws_apigatewayv2_integration" "get_demo" {
  api_id                 = aws_apigatewayv2_api.main.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.get_demo.invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "get_demo" {
  api_id    = aws_apigatewayv2_api.main.id
  route_key = "GET /demo"
  target    = "integrations/${aws_apigatewayv2_integration.get_demo.id}"
  # Deliberately no authorizer_id/authorization_type — see comment above.
}

# POST /uploads (ADR-0045) issues a presigned POST so the client uploads
# its Terraform archive straight to S3, never through this Lambda or API
# Gateway. Admin-gated like every non-demo route, since it lets the
# caller write an object into this account's bucket.
data "aws_iam_policy_document" "create_upload_data_access" {
  statement {
    effect    = "Allow"
    actions   = ["s3:PutObject", "s3:GetObject"]
    resources = ["${var.reports_bucket_arn}/uploads/*"]
  }
}

resource "aws_iam_role" "create_upload" {
  name                 = "${var.name_prefix}-create-upload"
  assume_role_policy   = data.aws_iam_policy_document.admin_authorizer_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy_attachment" "create_upload_basic_logs" {
  role       = aws_iam_role.create_upload.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "create_upload_data_access" {
  name   = "${var.name_prefix}-create-upload-data-access"
  role   = aws_iam_role.create_upload.id
  policy = data.aws_iam_policy_document.create_upload_data_access.json
}

resource "aws_lambda_function" "create_upload" {
  function_name    = "${var.name_prefix}-create-upload"
  role             = aws_iam_role.create_upload.arn
  handler          = "backend.lambdas.create_upload.handler.handler"
  runtime          = "python3.12"
  filename         = var.create_upload_zip_path
  source_code_hash = fileexists(var.create_upload_zip_path) ? filebase64sha256(var.create_upload_zip_path) : null
  timeout          = 15

  environment {
    variables = merge(local.admission_environment, {
      REPORTS_BUCKET_NAME = var.reports_bucket_name
      RESERVATION_KEY    = random_password.reservation.result
    })
  }

  tags = var.tags
}

resource "aws_lambda_permission" "apigw_invoke_create_upload" {
  statement_id  = "AllowAPIGatewayInvokeCreateUpload"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.create_upload.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.main.execution_arn}/*/*"
}

resource "aws_apigatewayv2_integration" "create_upload" {
  api_id                 = aws_apigatewayv2_api.main.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.create_upload.invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "post_uploads" {
  api_id             = aws_apigatewayv2_api.main.id
  route_key          = "POST /uploads"
  target             = "integrations/${aws_apigatewayv2_integration.create_upload.id}"
  authorizer_id      = aws_apigatewayv2_authorizer.admin_gate.id
  authorization_type = "CUSTOM"
}

# Regional custom domain for this API, created only when a validated
# certificate is supplied (see var.certificate_arn). Regional rather than
# edge-optimized: the API lives in one region and gains nothing from an
# extra CloudFront hop.
resource "aws_apigatewayv2_domain_name" "api" {
  count       = var.certificate_arn == null ? 0 : 1
  domain_name = var.domain_name

  domain_name_configuration {
    certificate_arn = var.certificate_arn
    endpoint_type   = "REGIONAL"
    security_policy = "TLS_1_2"
  }

  tags = var.tags
}

resource "aws_apigatewayv2_api_mapping" "api" {
  count       = var.certificate_arn == null ? 0 : 1
  api_id      = aws_apigatewayv2_api.main.id
  domain_name = aws_apigatewayv2_domain_name.api[0].id
  stage       = aws_apigatewayv2_stage.default.id
}

resource "aws_apigatewayv2_stage" "default" {
  api_id      = aws_apigatewayv2_api.main.id
  name        = "$default"
  auto_deploy = true

  default_route_settings {
    throttling_burst_limit = var.throttling_burst_limit
    throttling_rate_limit  = var.throttling_rate_limit
  }

  # GET /demo gets its own, lower quota (see demo_throttling_* in
  # variables.tf) instead of sharing the default bucket with every
  # admin-gated route.
  route_settings {
    route_key              = aws_apigatewayv2_route.get_demo.route_key
    throttling_burst_limit = var.demo_throttling_burst_limit
    throttling_rate_limit  = var.demo_throttling_rate_limit
  }

  # Each chat question is a paid model call (ADR-0050 §5). The daily $ cap
  # is the real stop; this keeps one client from spending it in seconds.
  route_settings {
    route_key              = aws_apigatewayv2_route.post_questions.route_key
    throttling_burst_limit = var.chat_throttling_burst_limit
    throttling_rate_limit  = var.chat_throttling_rate_limit
  }

  tags = var.tags
}
