# Terraform module: api-gateway
# HTTP API (API Gateway v2) — gated by a single pre-shared admin
# credential (ADR-0044, supersedes the Cognito JWT authorizer and the
# temporary IP-allowlist authorizer this replaces), throttling/usage
# plans as a best-effort layer, not a guaranteed ceiling (ADR-0005,
# ADR-0030 — real enforcement is the application-level layered controls
# built in the backend, not this module). Routes match the API contracts
# in Work-Project-System-Design.md. POST /reviews integrates directly
# with Step Functions StartExecution — no BFF Lambda (ADR-0016/0042).
#
# No user accounts exist (ADR-0044) — there is no Cognito JWT authorizer.
# GET /demo (guest/demo, static precomputed report) is intentionally
# public and unauthenticated; it never touches this gated integration.
#
# GET /reviews/{reviewId}, POST /clarify, and the "go deeper" endpoint
# need a DynamoDB/Step-Functions-task-token direct integration whose
# exact request/response mapping is an implementation detail to verify
# against the live API Gateway v2 AWS_PROXY subtype support at build
# time — modeled here with the integration resource shape, mapping TODOs
# flagged inline.

resource "aws_apigatewayv2_api" "main" {
  name          = "${var.name_prefix}-api"
  protocol_type = "HTTP"

  cors_configuration {
    allow_origins = ["https://archibrief.dev"]
    allow_methods = ["GET", "POST", "OPTIONS"]
    allow_headers = ["authorization", "content-type", "x-admin-key"]
  }

  tags = var.tags
}

# Single pre-shared admin credential, generated by Terraform and stored
# in Secrets Manager (ADR-0044) — never committed to source. Fernando
# retrieves the value once (via the AWS console/CLI, `terraform output`
# marked sensitive, or reading the secret directly) and pastes it into
# the frontend's admin-key field; it's sent back as the `x-admin-key`
# header on every gated request.
resource "random_password" "admin_key" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "admin_key" {
  name = "${var.name_prefix}-admin-key"
  tags = var.tags

  # Dev-only, no real audit-retention need — recreate cleanly on
  # destroy/replace instead of leaving a same-named secret stuck in AWS's
  # default 30-day recovery window (hit this exact problem 2026-09-11).
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "admin_key" {
  secret_id     = aws_secretsmanager_secret.admin_key.id
  secret_string = random_password.admin_key.result
}

data "aws_iam_policy_document" "admin_authorizer_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "admin_authorizer" {
  name                 = "${var.name_prefix}-admin-authorizer"
  assume_role_policy   = data.aws_iam_policy_document.admin_authorizer_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy_attachment" "admin_authorizer_basic_logs" {
  role       = aws_iam_role.admin_authorizer.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_lambda_function" "admin_authorizer" {
  function_name    = "${var.name_prefix}-admin-authorizer"
  role             = aws_iam_role.admin_authorizer.arn
  handler          = "backend.lambdas.admin_authorizer.handler.handler"
  runtime          = "python3.12"
  filename         = var.admin_authorizer_zip_path
  source_code_hash = fileexists(var.admin_authorizer_zip_path) ? filebase64sha256(var.admin_authorizer_zip_path) : null
  timeout          = 3

  environment {
    variables = {
      ADMIN_KEY = random_password.admin_key.result
    }
  }

  tags = var.tags
}

resource "aws_lambda_permission" "apigw_invoke_admin_authorizer" {
  statement_id  = "AllowAPIGatewayInvokeAdminAuthorizer"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.admin_authorizer.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.main.execution_arn}/*/*"
}

resource "aws_apigatewayv2_authorizer" "admin_gate" {
  api_id                            = aws_apigatewayv2_api.main.id
  authorizer_type                   = "REQUEST"
  name                              = "${var.name_prefix}-admin-gate"
  authorizer_uri                    = aws_lambda_function.admin_authorizer.invoke_arn
  authorizer_payload_format_version = "2.0"
  enable_simple_responses           = true
  authorizer_result_ttl_in_seconds  = 0
  identity_sources                  = ["$request.header.x-admin-key"]
}

data "aws_iam_policy_document" "apigw_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["apigateway.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "apigw_invoke_step_functions" {
  name                 = "${var.name_prefix}-apigw-invoke-sfn"
  assume_role_policy   = data.aws_iam_policy_document.apigw_trust.json
  permissions_boundary = var.permissions_boundary_arn
  tags                 = var.tags
}

resource "aws_iam_role_policy" "apigw_invoke_step_functions" {
  name = "${var.name_prefix}-apigw-start-execution"
  role = aws_iam_role.apigw_invoke_step_functions.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "states:StartExecution"
      Resource = var.state_machine_arn
    }]
  })
}

resource "aws_apigatewayv2_integration" "start_review" {
  api_id                 = aws_apigatewayv2_api.main.id
  integration_type       = "AWS_PROXY"
  integration_subtype    = "StepFunctions-StartExecution"
  credentials_arn        = aws_iam_role.apigw_invoke_step_functions.arn
  payload_format_version = "1.0"

  request_parameters = {
    StateMachineArn = var.state_machine_arn
    Input           = "$request.body"
  }
}

# Only POST /reviews is wired for now. GET /reviews/{reviewId},
# POST /clarify, POST /deeper, and GET /demo were previously wired to
# this same StartExecution integration before their real logic existed
# (GET /demo unauthenticated) — found in a 2026-09-09 audit sweep: this
# would have let any internet caller trigger a real, billed Step
# Functions execution against placeholder routes, GET /demo without even
# authentication. Removed until each route's actual integration
# (DynamoDB read, task-token resume, guest/demo caching) is built — see
# Work-Project-Issues-Log.md. Re-add each route only alongside its real
# backing logic, never wired to a stand-in integration again.
#
# authorizer_id points at the pre-shared admin-credential authorizer
# (ADR-0044) — this is the only auth ArchiBrief has; there is no
# per-user identity to check.
resource "aws_apigatewayv2_route" "post_reviews" {
  api_id             = aws_apigatewayv2_api.main.id
  route_key          = "POST /reviews"
  target             = "integrations/${aws_apigatewayv2_integration.start_review.id}"
  authorizer_id      = aws_apigatewayv2_authorizer.admin_gate.id
  authorization_type = "CUSTOM"
}

resource "aws_apigatewayv2_stage" "default" {
  api_id      = aws_apigatewayv2_api.main.id
  name        = "$default"
  auto_deploy = true

  default_route_settings {
    throttling_burst_limit = var.throttling_burst_limit
    throttling_rate_limit  = var.throttling_rate_limit
  }

  tags = var.tags
}
