# Free unit tests use injected clients/mocked AWS. No root .env file or
# credentials are needed. Python does not automatically load this file.
# Frontend settings belong in frontend/.env.local; see its .env.example.
# Terraform supplies Lambda/runtime settings at deployment.
# Networked corpus/model evaluation requires deliberate configuration and
# authorization; see docs/evaluation-runbook.md before invoking a runner.
AWS_REGION=us-east-1
