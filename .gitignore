!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lambda build output (vendored deps + zips, rebuilt from source, not source itself)
backend/build/
backend/lambdas/*/build/
backend/agent/build/

# Local AI-assistant tooling state and worktrees (full repo copies, not
# source)
.claude/

# RAG corpus fetch output (regenerated by backend/corpus/ingest.py, not source itself)
backend/corpus/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
.next-e2e-*/
out/
out-fixture/
out-live/
.env
.env.local
.env.*.local

# Playwright E2E
playwright-report/
test-results/

# Secrets / local config
# Every .env variant (.env.production, .env.test, ...) except committed examples.
.env
.env.*
!.env.example
# Local deploy-role policy variants (the split policy set, any *.local.json).
deploy-role-policies-proposed/
*.local.json
*.pem
*.key
credentials.json
deploy-role-policy.json
!deploy-role-policy.example.json
_apply-commands.txt

# Local IAM policy drafts; they contain real account IDs/ARNs, like
# deploy-role-policy.json above.
infra/environments/dev/deploy-role-policies-proposed/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Lighthouse CI output (npm run lighthouse)
frontend/out-public/
frontend/lighthouse-reports/
frontend/.lighthouseci/

# Old design experiments and internal working pages, kept local only.
docs/site/

# Local Terraform plan text output (account details).
infra/environments/dev/tmp/
