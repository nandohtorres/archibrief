{
  "name": "archibrief-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ArchiBrief frontend — Next.js, static/client-first rendering (ADR-0016/0042)",
  "engines": {
    "node": "^22.12.0 || 24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node ../scripts/write_frontend_build_info.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . ../tests/frontend",
    "format:check": "prettier --check . ../tests/frontend",
    "test": "vitest run --globals --environment node --pool threads --maxWorkers 1 --dir ../tests/frontend",
    "test:watch": "vitest --globals --environment node --pool threads --maxWorkers 1 --dir ../tests/frontend",
    "build:e2e": "next build",
    "postbuild:e2e": "node ../scripts/write_frontend_build_info.mjs",
    "test:e2e": "playwright test",
    "test:tooling": "node --test ../tests/tooling/e2e-build-log.test.mjs",
    "lighthouse": "node e2e/dev-server.mjs live --build-only && npx --yes @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.2",
    "next": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.9.10",
    "serve": "^14.2.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "compression": "^1.8.2",
    "tmp": "^0.2.7"
  }
}
