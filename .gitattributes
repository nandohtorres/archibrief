# Hooks run under sh; CRLF line endings break them.
.githooks/* text eol=lf
# Keep source and formatter output consistent on Windows and Linux.
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.tf text eol=lf
